{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/blog/:slug((?!turning-social-platforms-into-scalable-growth-channels|the-growth-systems-behind-high-performing-marketing-campaigns|why-strong-branding-is-the-foundation-of-every-successful-business).*)",
      "destination": "/blog/post"
    }
  ],
  "headers": [
    {
      "source": "/case-studies",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
