# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Domain (used for canonical URL injection into HTML responses) ─────────────
SITE_DOMAIN=http://localhost:3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of the frontend (Framer export served by Express or a separate dev server)
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://CHANGE_ME:CHANGE_ME@cluster.mongodb.net/fdz-velora

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per IP per window (global — individual routes may override)
RATE_LIMIT_MAX=100
